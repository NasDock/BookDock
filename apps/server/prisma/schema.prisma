// =============================================================================
// BookDock - Prisma Schema
// =============================================================================
// This schema maps to the PostgreSQL database defined in scripts/init-db.sql
// Run `npx prisma generate` after modifying this file.
// Run `npx prisma db push` to sync schema changes to the database.
// Run `npx prisma migrate dev` to create migrations.
// =============================================================================

generator client {
  provider        = "prisma-client-js"

}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")

}

// =============================================================================
// Enums (map to PostgreSQL ENUMs)
// =============================================================================






// =============================================================================
// Models
// =============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String    @map("password_hash")
  displayName   String?   @map("display_name")
  role          String    @default("user")
  avatarUrl     String?   @map("avatar_url")
  preferences   String    @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  isActive      Boolean   @default(true) @map("is_active")
  phone         String?   @unique @map("phone")

  // Relations
  collections        Collection[]
  readingProgress    ReadingProgress[]
  bookmarks          Bookmark[]
  ttsJobs            TtsJob[]
  ttsAudioFiles      TtsAudioFile[]
  sessions           Session[]
  apiKeys            ApiKey[]
  vipMember          VipMember?

  @@map("users")
}

model Book {
  id            String      @id @default(uuid())
  title         String     
  author        String?    
  authorSort    String?     @map("author_sort")
  description   String?    
  isbn          String?     @map("isbn")
  publisher     String?    
  publishedDate DateTime?   @map("published_date")
  language      String      @default("en")
  format        String      @default("other")
  filePath      String      @map("file_path")
  fileHash      String?     @map("file_hash")
  fileSize      BigInt?     @map("file_size")
  pageCount     Int?        @map("page_count")
  coverUrl      String?     @map("cover_url")
  metadata      String      @default("{}")
  readCount     Int         @default(0) @map("read_count")
  downloadCount Int         @default(0) @map("download_count")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  isDeleted     Boolean     @default(false) @map("is_deleted")

  // Full-text search (PostgreSQL tsvector - managed via raw SQL trigger)
  // ftsVector     Unsupported("tsvector")?

  // Relations
  collectionItems CollectionItem[]
  readingProgress ReadingProgress[]
  bookmarks      Bookmark[]
  ttsJobs        TtsJob[]
  ttsAudioFiles  TtsAudioFile[]
  bookTags       BookTag[]

  @@index([title])
  @@index([author])
  @@index([authorSort])
  @@index([format])
  @@index([language])
  @@index([createdAt(sort: Desc)])
  @@index([fileHash])
  @@map("books")
}

model Collection {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String   
  description String?  
  coverUrl    String?   @map("cover_url")
  isPublic    Boolean   @default(false) @map("is_public")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CollectionItem[]

  @@index([userId])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  bookId       String   @map("book_id")
  sortOrder    Int      @default(0) @map("sort_order")
  addedAt      DateTime @default(now()) @map("added_at")

  // Relations
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([collectionId, bookId])
  @@index([collectionId])
  @@index([bookId])
  @@map("collection_items")
}

model ReadingProgress {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  bookId        String        @map("book_id")
  status        String        @default("unread")
  // EPUB location
  epubCfi       String?       @map("epub_cfi")
  // PDF location
  pdfPage       Int?          @map("pdf_page")
  // Mobi location
  mobiLocation  Int?          @map("mobi_location")
  // Progress
  progressPct   Float         @default(0) @map("progress_pct")
  currentChapter Int?         @map("current_chapter")
  scrollOffset  Int?          @map("scroll_offset")
  timeSpentSecs Int           @default(0) @map("time_spent_secs")
  lastReadAt    DateTime?     @map("last_read_at")
  bookmarkNote  String?       @map("bookmark_note")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([lastReadAt(sort: Desc)])
  @@map("reading_progress")
}

model Bookmark {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  bookId         String    @map("book_id")
  chapterId      String?   @map("chapter_id")
  cfi            String?  
  percentage     Float?    @map("percentage")
  // For highlights
  startOffset    Int?      @map("start_offset")
  endOffset      Int?      @map("end_offset")
  text           String?  
  // Legacy fields (kept for backwards compat)
  title          String?  
  location       String   
  locationType   String    @default("cfi") @map("location_type")
  note           String?  
  highlightText  String?   @map("highlight_text")
  highlightColor String?   @map("highlight_color")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@map("bookmarks")
}

model TtsJob {
  id          String        @id @default(uuid())
  userId      String?       @map("user_id")
  bookId      String?       @map("book_id")
  status      String        @default("pending")
  voice       String        @default("en_US-lessac-medium")
  gender      String         @default("neutral")
  sampleRate  Int           @default(22050)
  startCfi    String?       @map("start_cfi")
  endCfi      String?       @map("end_cfi")
  outputPath  String?       @map("output_path")
  outputUrl   String?       @map("output_url")
  fileSize    BigInt?       @map("file_size")
  durationSecs Float?       @map("duration_secs")
  errorMessage String?      @map("error_message")
  retryCount  Int           @default(0) @map("retry_count")
  maxRetries Int            @default(3) @map("max_retries")
  createdAt   DateTime      @default(now()) @map("created_at")
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("tts_jobs")
}

model TtsAudioFile {
  id            String    @id @default(uuid())
  bookId        String    @map("book_id")
  userId        String?   @map("user_id")
  filePath      String    @map("file_path")
  fileUrl       String?   @map("file_url")
  fileSize      BigInt?   @map("file_size")
  durationSecs  Float?    @map("duration_secs")
  voice         String?  
  sampleRate    Int?      @map("sample_rate")
  startCfi      String?   @map("start_cfi")
  endCfi        String?   @map("end_cfi")
  contentHash   String?   @map("content_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  book Book?  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([userId])
  @@map("tts_audio_files")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?  
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  bookTags BookTag[]

  @@map("tags")
}

model BookTag {
  bookId String @map("book_id")
  tagId  String @map("tag_id")

  // Relations
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([bookId])
  @@index([tagId])
  @@map("book_tags")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @map("refresh_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String   
  keyHash     String    @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  isActive    Boolean   @default(true) @map("is_active")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// VIP Members (phone-based lightweight accounts)
model VipMember {
  id        String    @id @default(uuid())
  userId    String    @unique @map("user_id")
  phone     String    @unique
  level     String    @default("free") // "free" | "year" | "lifetime"
  expiredAt DateTime? @map("expired_at") // null = 永久
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vip_members")
}

// VIP Orders
model VipOrder {
  id        String    @id @default(uuid())
  orderId   String    @unique @map("order_id")
  userId    String    @map("user_id")
  productId String    @map("product_id") // "year" | "lifetime"
  amount    Float     // RMB (20 or 60)
  status    String    @default("pending") @map("status") // "pending" | "paid" | "expired"
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([orderId])
  @@map("vip_orders")
}

model IndexerJob {
  id          String    @id @default(uuid())
  filePath    String    @map("file_path")
  priority    Int       @default(0)
  status      String    @default("pending")
  attempts    Int       @default(0)
  error       String?  
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status])
  @@index([createdAt])
  @@map("indexer_jobs")
}

model SystemConfig {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
