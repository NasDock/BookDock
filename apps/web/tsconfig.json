{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@api-client/*": ["../../packages/api-client/src/*"],
      "@ebook-reader/*": ["../../packages/ebook-reader/src/*"],
      "@tts/*": ["../../packages/tts/src/*"],
      "@auth/*": ["../../packages/auth/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
